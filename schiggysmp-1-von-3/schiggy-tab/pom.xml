
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.schiggy</groupId>
        <artifactId>schiggy-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>schiggy-tab</artifactId>

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
        </dependency>

        <dependency>
            <groupId>de.schiggy</groupId>
            <artifactId>schiggy-core</artifactId>
        </dependency>

        <dependency>
            <groupId>de.schiggy</groupId>
            <artifactId>schiggy-settings</artifactId>
        </dependency>

        <dependency>
            <groupId>de.schiggy</groupId>
            <artifactId>schiggy-stats</artifactId>
        </dependency>

        <dependency>
            <groupId>de.schiggy</groupId>
            <artifactId>schiggy-economy</artifactId>
        </dependency>

        <dependency>
            <groupId>net.luckperms</groupId>
            <artifactId>api</artifactId>
        </dependency>

        <!-- FoliaBoard API -->
        <dependency>
            <groupId>com.github.SpirtySprite.ScoreboardAPI-FOLIA</groupId>
            <artifactId>foliaboard-core</artifactId>
            <version>1.0.3</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>SchiggyTab</finalName>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>

                            <relocations>
                                <relocation>
                                    <pattern>net.foliaboard</pattern>
                                    <shadedPattern>de.schiggy.tab.libs.foliaboard</shadedPattern>
                                </relocation>
                            </relocations>

                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
